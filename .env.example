# ============================================
# Ambiente
# ============================================
APP_ENV=dev                 # dev | staging | prod
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json             # json | text

# ============================================
# LLM (FASE 2+) - NUNCA commitar valores reais
# ============================================
LLM_PROVIDER=openai         # openai | google | anthropic
LLM_MODEL=gpt-4o
LLM_API_KEY=
LLM_TEMPERATURE=0.2

# ============================================
# Telegram (FASE 2)
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=  # separados por virgula: 123,456

# ============================================
# Google (FASE 2) - DESABILITADO: n8n cuida de Drive/Sheets via OAuth
# ============================================
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_SHEETS_SPREADSHEET_ID=

# ============================================
# Redes Sociais (FASE 7) - NUNCA commitar tokens reais
# ============================================
SOCIAL_ENABLE_INSTAGRAM=false
SOCIAL_ENABLE_FACEBOOK=false
SOCIAL_ENABLE_TIKTOK=false
META_ACCESS_TOKEN=              # Graph API (Instagram + Facebook)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=

# ============================================
# Aprovação de campanha (FASE 10)
# ============================================
# true  = publica direto após gerar imagem
# false = envia prévia no Telegram e aguarda PUBLICAR / CANCELAR / REFAZER
AUTO_PUBLISH=true

# ============================================
# n8n (callbacks / webhooks)
# ============================================
N8N_BASE_URL=https://orquestrador.app.n8n.cloud
N8N_WEBHOOK_SECRET=

# ============================================
# LangGraph checkpointer (prod: postgres / Supabase)
# ============================================
CHECKPOINTER_BACKEND=postgres # memory | postgres
DATABASE_URL=               # postgresql://user:pass@host:5432/db (Supabase)

# ============================================
# Camada Repository — PostgreSQL / Supabase (produção)
# ============================================
# sqlite   = dev/testes (padrão, não muda nada)
# postgres = produção; exige DATABASE_URL
DATABASE_BACKEND=postgres
# Espelho opcional: grava também no Google Sheets (visualização admin).
# O PostgreSQL continua sendo a fonte da verdade.
SHEETS_MIRROR_ENABLED=false
